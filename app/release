#!/bin/bash
# Builds SitRep's release on this Mac and uploads it to the GitHub release:
# mint's post_release runs it from the repository's root, once the tag and
# the release are pushed. The app is built from the tagged tree (app/bundle),
# notarized and stapled (app/notarize), and uploaded as SitRep-<version>.zip,
# and the cask in leeovery/homebrew-tools is sent the new zip.
#
# mint shows nothing a hook prints when it goes well, and only what it prints
# to stderr when it fails, so everything goes to stderr and to a log,
# ~/Library/Logs/SitRep/release-<version>.log, which keeps the asset's id,
# its sha256 and, when sending the cask fails, the command that sends it.
#
# mint only warns when it fails, so it can be run again by hand: with no mint
# environment, it releases the version plugin.json names, or the one given,
# tagged v<version>, and its upload replaces one already there.
set -euo pipefail

if [[ $# -gt 1 ]]; then
  echo "Usage: app/release [<version>]" >&2
  exit 1
fi

app=$(cd "$(dirname "$0")" && pwd)
repo=$(dirname "$app")
cd "$repo"

if [[ $# -eq 1 ]]; then
  version=$1
  tag=v$version
else
  version=${MINT_NEW_VERSION:-$(plutil -extract version raw -o - .claude-plugin/plugin.json)}
  tag=${MINT_VERSION_TAG:-v$version}
fi
asset="SitRep-$version.zip"

log="$HOME/Library/Logs/SitRep/release-$version.log"
mkdir -p "$(dirname "$log")"
exec > >(tee -a "$log" >&2) 2>&1
echo "== app/release $tag, $(date), logged to $log"

work=$(mktemp -d)
tree="$work/tree"
finish() {
  git worktree remove --force "$tree" 2> /dev/null || true
  rm -rf "$work"
  echo "Logged to $log"
}
trap finish EXIT

if ! git rev-parse -q --verify "refs/tags/$tag" > /dev/null; then
  echo "No tag $tag: app/release builds a release from its tag."
  exit 1
fi
if ! gh release view "$tag" > /dev/null; then
  echo "No GitHub release $tag to upload SitRep to."
  exit 1
fi

# Built outside the repository, from the tag's tree as git holds it, by the
# tag's own app/bundle.
git worktree add --quiet --detach "$tree" "$tag"
"$tree/app/bundle" --release "$work"
built=$(plutil -extract CFBundleShortVersionString raw -o - "$work/SitRep.app/Contents/Info.plist")
if [[ $built != "$version" ]]; then
  echo "$tag builds SitRep $built, not $version."
  exit 1
fi

zip="$work/$asset"
"$app/notarize" "$work/SitRep.app" "$zip"
sha=$(shasum -a 256 "$zip" | cut -d ' ' -f 1)
echo "$asset: sha256 $sha"
if ! gh release upload "$tag" "$zip" --clobber; then
  echo "Uploading $asset to $tag failed: app/release, run again, builds and notarizes it again."
  exit 1
fi
id=$(gh api "repos/{owner}/{repo}/releases/tags/$tag" --jq ".assets[] | select(.name == \"$asset\") | .id")
if [[ ! $id =~ ^[0-9]+$ ]]; then
  echo "GitHub lists no asset $asset on $tag after its upload."
  exit 1
fi
echo "Uploaded $asset to $tag: asset $id, sha256 $sha"

# The tap's update, which hands the cask in leeovery/homebrew-tools this
# version, the asset's id and its sha256. Every run that uploads dispatches it
# again: a new zip has another sha256, and its asset another id. Only for the
# latest release: brew takes any other version than the one installed as an
# upgrade, so the cask on an older one would downgrade every Mac.
tap=leeovery/homebrew-tools
dispatch=(gh api "repos/$tap/dispatches" --silent
  -f event_type=update-formula -f "client_payload[tool]=sitrep" -f "client_payload[version]=$version"
  -f "client_payload[sha256]=$sha" -f "client_payload[asset_id]=$id")
printf -v resend '%q ' "${dispatch[@]}"
failed() {
  echo "$1, with $asset uploaded to $tag. Send the cask $version by hand with"
  echo "${resend% }"
  exit 1
}
if ! latest=$(gh release view --json tagName --jq .tagName); then
  failed "Finding the latest release failed"
fi
if [[ $tag != "$latest" ]]; then
  echo "$tag is not the latest release, $latest, so the cask stays on $latest; $asset is uploaded to $tag alone."
  exit 0
fi

# GitHub accepts a dispatch before any run starts, so the run it starts is
# found and waited on: the first of the tap's update-formula runs newer than
# the last before it, by id, which, unlike a time, doesn't hang on this Mac's
# clock, and named, by the workflow's run-name, for this cask and version, so
# another tool's run started beside it isn't taken for it. The workflow's own
# timeout bounds the wait on it.
title="Update sitrep to v$version"
runs=(gh run list -R "$tap" --workflow update-formula.yml --event repository_dispatch --limit 20 --json databaseId,displayTitle)
if ! before=$("${runs[@]}" --jq '[.[].databaseId] | max // 0'); then
  failed "Listing $tap's update-formula runs failed"
fi
if ! "${dispatch[@]}"; then
  failed "Sending the cask $version failed"
fi
run=""
for _ in {1..30}; do
  run=$("${runs[@]}" --jq "[.[] | select(.databaseId > $before and .displayTitle == \"$title\") | .databaseId] | min // empty" || true)
  [[ -z $run ]] || break
  sleep 2
done
if [[ -z $run ]]; then
  failed "$tap started no update-formula run within a minute of the cask $version being sent"
fi
url="https://github.com/$tap/actions/runs/$run"
echo "Sent $tap the cask $version: asset $id, sha256 $sha; its update is $url"
if ! gh run watch "$run" -R "$tap" --exit-status --interval 5 > /dev/null; then
  failed "$tap's update of the cask $version failed, at $url"
fi
echo "The cask is on $version, asset $id: $url"
