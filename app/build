#!/bin/bash
# Builds SitRep, signed with Lee's Developer ID and carrying the plugin
# (app/bundle), installs it to /Applications over the cask's copy and starts
# it, replacing the one running. The login item and macOS's permissions
# remember the app by where it is, so a build goes where the release is: both
# are kept, and there is never a second bundle with SitRep's id. It isn't
# notarized: a build installed from here is never quarantined, and
# notarizing would add minutes to every install. As it starts, the build
# refreshes SitRep's copy of the plugin with the one it carries, or leaves
# the sitrep marketplace as it is where it is not SitRep's own (app/plugin).
# `brew reinstall --cask sitrep` puts the release back, and the next
# `brew upgrade` replaces the build too.
set -euo pipefail

installed=/Applications/SitRep.app
app=$(cd "$(dirname "$0")" && pwd)

# Put together outside the repository, and gone once installed.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
"$app/bundle" "$work"
version=$(plutil -extract CFBundleShortVersionString raw -o - "$work/SitRep.app/Contents/Info.plist")

"$app/quit"

rm -rf "$installed"
ditto "$work/SitRep.app" "$installed"
open "$installed"

echo "SitRep $version installed to $installed; brew reinstall --cask sitrep puts the release back"
