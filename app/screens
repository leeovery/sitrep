#!/bin/bash
# Draws the README's pictures into art/screens, each from a made-up board, with
# nothing shown on the screen, on one made-up Mac's desktop at 2x: Claude Code
# in a Ghostty window, the board docked at its side, its cells laid out by
# screens/window.ts on Bun, drawn by ReadmeScreensTests and made a WebP by
# cwebp; and the notch at the screen's left edge opening as the pointer comes
# to it, filmed by ReadmeScreensTests frame by frame and put together by
# img2webp as an animated WebP; and the strip there at rest, the notch's
# alternative, its marks telling each state, drawn by ReadmeScreensTests and
# made a WebP by cwebp. Run it again whenever the look changes, and commit what
# it draws.
set -euo pipefail

if [[ $# -ne 0 ]]; then
  echo "Usage: app/screens" >&2
  exit 1
fi

for tool in cwebp img2webp; do
  if ! command -v "$tool" >/dev/null; then
    echo "app/screens needs $tool: brew install webp" >&2
    exit 1
  fi
done

repo=$(cd "$(dirname "$0")/.." && pwd)
screens=$repo/art/screens
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Bun takes its JSX factory from the tsconfig where it starts, so from the root
(cd "$repo" && bun screens/window.ts "$work/window.json")
SITREP_SCREENS=$work swift test --package-path "$repo/app" --filter ReadmeScreensTests

# Each frame of the film for as long as it shows, as ReadmeScreensTests listed them
frames=()
while read -r frame ms; do
  frames+=(-d "$ms" "$work/notch/$frame")
done <"$work/notch/frames.txt"

mkdir -p "$screens"
find "$screens" -maxdepth 1 -type f \( -name '*.png' -o -name '*.webp' -o -name '*.svg' \) -delete
# Lossy at high quality, its colours converted sharply so coloured text stays crisp: a seventh of the PNG's size
cwebp -quiet -q 90 -m 6 -sharp_yuv "$work/window.png" -o "$screens/claude-code.webp"
cwebp -quiet -q 90 -m 6 -sharp_yuv "$work/strip.png" -o "$screens/strip.webp"
# Each frame lossy or lossless, whichever is smaller: lossy alone leaves streaks in the black as frames build on it
img2webp -loop 0 -mixed -sharp_yuv -q 90 -m 6 "${frames[@]}" -o "$screens/notch.webp"
