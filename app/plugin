#!/bin/bash
# Says where Claude Code's sitrep plugin comes from, or switches it:
#   app/plugin here   the checkout this script is in, a worktree or the clone,
#                     for a live test of the plugin
#   app/plugin app    SitRep's own copy, ~/Library/Application Support/sitrep
# Every Claude window runs the plugin switched to from its next
# /reload-plugins. SitRep looks at the plugin only as it starts, so a switch
# ends with SitRep running: started where it isn't, and started again where
# the switch changed anything. On its copy, that start is what refreshes the
# copy, left at its old build by any update or app/build made while a
# checkout was the plugin; with the copy gone, `app` takes sitrep out of
# Claude Code, for SitRep's start to make the copy and install it as at its
# first start. A switch to where the plugin already comes from, installed and
# current, leaves Claude Code as it is. Nothing is switched or quit unless
# /Applications/SitRep.app is there to start, and, as SitRep does, it never
# puts a second sitrep beside one from another marketplace (DESIGN,
# "Anything of sitrep SitRep did not install").
set -euo pipefail

name=sitrep
marketplace=sitrep
plugin=sitrep@sitrep
own="$HOME/Library/Application Support/sitrep"
app=$(cd "$(dirname "$0")" && pwd -P)
checkout=$(dirname "$app")
switched=false

# A claude command, quiet unless it fails.
claude_quietly() {
  local said
  if ! said=$(claude "$@" 2>&1); then
    echo "claude $* failed:" >&2
    echo "$said" >&2
    exit 1
  fi
}

# One of Claude's lists, as JSON; a failure ends the script with claude's
# words. Run in a step of its own, so the failure is not lost.
listed() {
  local said
  if ! said=$(claude "$@" --json); then
    echo "claude $* --json failed${said:+: $said}" >&2
    exit 1
  fi
  printf '%s\n' "$said"
}

# A folder with its links followed; anything else, or a folder that isn't
# there, as given.
real() {
  if [[ $1 == /* ]] && (cd "$1" 2> /dev/null && pwd -P); then
    return
  fi
  echo "$1"
}

# A folder as Lee would write it.
written() {
  case $1 in
    "$HOME"/*) echo "~${1#"$HOME"}" ;;
    *) echo "$1" ;;
  esac
}

# Whether the folder is the sitrep marketplace, offering the plugin.
is_sitrep_marketplace() {
  jq -e --arg marketplace "$marketplace" --arg name "$name" \
    '.name == $marketplace and any(.plugins[]?; .name == $name)' \
    "$1/.claude-plugin/marketplace.json" > /dev/null 2>&1
}

# The sitrep marketplace's folder, or its source where it is not a folder,
# from Claude's list of marketplaces; nothing with no sitrep marketplace.
source_in() {
  jq -r --arg marketplace "$marketplace" \
    '.[] | select(.name == $marketplace) | if .source == "directory" then .path else (.repo // .url // .source) end' <<< "$1"
}

# Every installed plugin named sitrep from another marketplace, from Claude's
# list of plugins: `sitrep@kit`.
foreign_in() {
  jq -r --arg name "$name" --arg plugin "$plugin" \
    '[.[] | .id | select(split("@")[0] == $name and . != $plugin)] | join(", ")' <<< "$1"
}

# sitrep@sitrep's standing in Claude's list of plugins: enabled, disabled,
# or nothing where it isn't installed.
standing_in() {
  jq -r --arg plugin "$plugin" \
    '.[] | select(.id == $plugin) | if .enabled == false then "disabled" else "enabled" end' <<< "$1"
}

# Where a source is, as Lee would say it.
named() {
  if [[ $(real "$1") == "$(real "$own")" ]]; then
    echo "SitRep's own copy, $(written "$own")"
  elif [[ $(real "$1") == "$(real "$checkout")" ]]; then
    echo "this checkout, $(written "$checkout")"
  else
    written "$1"
  fi
}

say_where() {
  local marketplaces plugins now foreign standing
  marketplaces=$(listed plugin marketplace list)
  plugins=$(listed plugin list)
  now=$(source_in "$marketplaces")
  foreign=$(foreign_in "$plugins")
  standing=$(standing_in "$plugins")

  if [[ -n $foreign ]]; then
    echo "The sitrep plugin comes from another marketplace, $foreign, which app/plugin puts no second sitrep beside"
  elif [[ -z $now ]]; then
    echo "Claude Code has no sitrep marketplace; app/plugin app has SitRep install its copy"
  elif [[ $now == /* ]] && ! is_sitrep_marketplace "$now"; then
    echo "The sitrep marketplace is $(written "$now"), which is gone: windows load no sitrep at their next /reload-plugins. app/plugin app puts SitRep's copy back"
  elif [[ -z $standing ]]; then
    echo "The sitrep marketplace is $(named "$now"), but $plugin isn't installed; app/plugin app puts SitRep's copy back"
  elif [[ $standing == disabled ]]; then
    echo "The sitrep plugin comes from $(named "$now"), and is disabled in Claude Code: claude plugin enable $plugin turns it on"
  else
    echo "The sitrep plugin comes from $(named "$now")"
  fi
}

refuse_foreign() {
  local foreign
  foreign=$(foreign_in "$1")
  if [[ -n $foreign ]]; then
    echo "Claude Code has sitrep from another marketplace, $foreign, so app/plugin puts no second sitrep beside it" >&2
    exit 1
  fi
}

# Whether the marketplace is the folder, and sitrep@sitrep is installed from
# it at the folder's version.
is_current() {
  local folder=$1 marketplaces=$2 plugins=$3 now version installed
  now=$(source_in "$marketplaces")
  version=$(jq -r .version "$folder/.claude-plugin/plugin.json")
  installed=$(jq -r --arg plugin "$plugin" --arg version "$version" \
    '.[] | select(.id == $plugin and .version == $version) | .readFromFolder // empty' <<< "$plugins")

  [[ -n $now && -n $installed && $(real "$now") == "$folder" && $(real "$installed") == "$folder" ]]
}

# The marketplace re-pointed at the folder, an add over the registration
# there being one, and Claude's record of the plugin brought up to it; left
# as it is where it already was.
switch_to() {
  local folder marketplaces plugins
  folder=$(real "$1")
  if ! is_sitrep_marketplace "$folder"; then
    echo "No sitrep marketplace in $(written "$folder")" >&2
    exit 1
  fi

  marketplaces=$(listed plugin marketplace list)
  plugins=$(listed plugin list)
  refuse_foreign "$plugins"
  if is_current "$folder" "$marketplaces" "$plugins"; then
    echo "The sitrep plugin already comes from $(named "$folder"), installed and current"
    return
  fi

  claude_quietly plugin marketplace add "$folder"
  claude_quietly plugin marketplace update "$marketplace"
  if [[ -n $(standing_in "$plugins") ]]; then
    claude_quietly plugin update "$plugin"
  else
    claude_quietly plugin install "$plugin"
  fi
  switched=true
  say_where
  echo "Each Claude window runs it from its next /reload-plugins"
}

# With SitRep's copy gone, sitrep taken out of both of Claude's lists, for
# SitRep's start to copy, add and install it as at its first start.
hand_to_sitrep() {
  local marketplaces plugins
  marketplaces=$(listed plugin marketplace list)
  plugins=$(listed plugin list)
  refuse_foreign "$plugins"

  echo "SitRep's copy, $(written "$own"), is gone: SitRep makes it again as it starts, once Claude Code has no sitrep"
  if [[ -n $(standing_in "$plugins") ]]; then
    echo "Uninstalling $plugin"
    claude_quietly plugin uninstall "$plugin"
    switched=true
  fi
  if [[ -n $(source_in "$marketplaces") ]]; then
    echo "Removing the $marketplace marketplace"
    claude_quietly plugin marketplace remove "$marketplace"
    switched=true
  fi
  echo "Each Claude window runs SitRep's copy from its next /reload-plugins once SitRep has started"
}

# SitRep left running: started where it isn't, and started again where the
# switch changed anything, for it to do what is given.
settle_sitrep() {
  if ! pgrep -U "$UID" -x SitRep > /dev/null; then
    echo "Starting SitRep, for it to $1"
    "$app/open"
  elif $switched; then
    echo "Starting SitRep again, for it to $1"
    "$app/quit"
    "$app/open"
  fi
}

if [[ $# -gt 1 ]]; then
  echo "Usage: app/plugin [here | app]" >&2
  exit 1
fi

case "${1-}" in
  "")
    say_where
    ;;
  here)
    "$app/open" --check
    switch_to "$checkout"
    settle_sitrep "run this checkout's CLI"
    ;;
  app)
    "$app/open" --check
    if is_sitrep_marketplace "$own"; then
      switch_to "$own"
      settle_sitrep "refresh its copy and run it"
    else
      hand_to_sitrep
      settle_sitrep "make its copy and install it"
    fi
    ;;
  *)
    echo "Usage: app/plugin [here | app]" >&2
    exit 1
    ;;
esac
