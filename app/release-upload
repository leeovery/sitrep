#!/bin/bash
# Uploads SitRep's release, which app/release-build built, notarized and kept
# before the tag, to the GitHub release mint made, and sends the cask in
# leeovery/homebrew-tools the new zip: mint's post_release runs it, from the
# repository's root, with the version in MINT_NEW_VERSION and its tag in
# MINT_VERSION_TAG. Nothing is built after the tag: the zip kept is uploaded
# only where the commit built lies under the tag with nothing but mint's
# bookkeeping changed since; otherwise it stops, saying how to build the
# tag's tree again.
#
# mint shows nothing a hook prints when it goes well, and only what it prints
# to stderr when it fails, so everything goes to stderr and to a log,
# ~/Library/Logs/SitRep/release-<version>.log, which keeps the asset's id,
# its sha256 and, when sending the cask fails, the command that sends it. The
# cask downloads the zip from the release's public URL, by its name, so the
# tap needs only the version and the sha256: the asset's id is looked up only
# to check that GitHub lists the upload.
#
# mint only warns when it fails, so it can be run again by hand: with no mint
# environment, it uploads the version plugin.json names, or the one given,
# tagged v<version>, and its upload replaces one already there.
set -euo pipefail

if [[ $# -gt 1 ]]; then
  echo "Usage: app/release-upload [<version>]" >&2
  exit 1
fi

app=$(cd "$(dirname "$0")" && pwd)
repo=$(dirname "$app")
# shellcheck source=app/release-common
. "$app/release-common"
cd "$repo"

if [[ $# -eq 1 ]]; then
  version=$1
  tag=v$version
else
  version=${MINT_NEW_VERSION:-$(plutil -extract version raw -o - "$release_version_file")}
  tag=${MINT_VERSION_TAG:-v$version}
fi
release_valid_version "$version" || release_fail "$version isn't a version, as 0.3.1."
asset=$(release_asset "$version")

release_log app/release-upload "$version"
kept=$(release_kept "$version")
zip="$kept/$asset"

if ! git rev-parse -q --verify "refs/tags/$tag" > /dev/null; then
  release_fail "No tag $tag: app/release-upload uploads to a tagged release."
fi
if ! gh release view "$tag" > /dev/null; then
  release_fail "No GitHub release $tag to upload SitRep to."
fi

# Whether the build kept is whole and of what the tag holds, saying why not
# in $why.
kept_fits() {
  local file commit
  for file in "$zip" "$zip.sha256" "$kept/commit"; do
    if [[ ! -f $file ]]; then
      why="$kept has no $(basename "$file")"
      return 1
    fi
  done
  if ! (cd "$kept" && shasum -a 256 --check --status "$asset.sha256"); then
    why="$asset doesn't match its sha256"
    return 1
  fi
  commit=$(< "$kept/commit")
  if ! git merge-base --is-ancestor "$commit" "$tag" 2> /dev/null; then
    why="$commit, the commit built, isn't under $tag"
    return 1
  fi
  if ! release_bookkeeping_only "$commit" "$tag"; then
    why="the tag, since $commit, the commit built, $why"
    return 1
  fi
}
if ! kept_fits; then
  release_fail "Nothing to upload for $tag, as $why"$'\n'"Build the tag again, which notarizes it, with app/release-build $version $tag; then app/release-upload $version uploads it."
fi

sha=$(cut -d ' ' -f 1 "$zip.sha256")
echo "$asset: sha256 $sha, built from $(< "$kept/commit")"
if ! gh release upload "$tag" "$zip" --clobber; then
  release_fail "Uploading $asset to $tag failed: app/release-upload $version, run again, uploads it from $kept."
fi
id=$(gh api "repos/{owner}/{repo}/releases/tags/$tag" --jq ".assets[] | select(.name == \"$asset\") | .id")
if [[ ! $id =~ ^[0-9]+$ ]]; then
  release_fail "GitHub lists no asset $asset on $tag after its upload."
fi
echo "Uploaded $asset to $tag: asset $id, sha256 $sha"

# The tap's update, which hands the cask in leeovery/homebrew-tools this
# version and the zip's sha256, for the latest release only: brew takes any
# other version than the one installed as an upgrade, so the cask on an older
# one would downgrade every Mac. A rerun sends the same sha256 again, which
# changes nothing; the send matters after app/release-build has built the zip
# again, or after an earlier send failed.
tap=leeovery/homebrew-tools
dispatch=(gh api "repos/$tap/dispatches" --silent
  -f event_type=update-formula -f "client_payload[tool]=sitrep" -f "client_payload[version]=$version"
  -f "client_payload[sha256]=$sha")
printf -v resend '%q ' "${dispatch[@]}"
failed() {
  echo "$1, with $asset uploaded to $tag. Send the cask $version by hand with"
  echo "${resend% }"
  exit 1
}
if ! latest=$(gh release view --json tagName --jq .tagName); then
  failed "Finding the latest release failed"
fi
if [[ $tag != "$latest" ]]; then
  echo "$tag is not the latest release, $latest, so the cask stays on $latest; $asset is uploaded to $tag alone."
  exit 0
fi

# GitHub accepts a dispatch before any run starts, so the run it starts is
# found and waited on: the first of the tap's update-formula runs newer than
# the last before it, by id, which, unlike a time, doesn't hang on this Mac's
# clock, and named, by the workflow's run-name, for this cask and version, so
# another tool's run started beside it isn't taken for it. The workflow's own
# timeout bounds the wait on it.
title="Update sitrep to v$version"
runs=(gh run list -R "$tap" --workflow update-formula.yml --event repository_dispatch --limit 20 --json "databaseId,displayTitle")
if ! before=$("${runs[@]}" --jq '[.[].databaseId] | max // 0'); then
  failed "Listing $tap's update-formula runs failed"
fi
if ! "${dispatch[@]}"; then
  failed "Sending the cask $version failed"
fi
run=""
for _ in {1..30}; do
  run=$("${runs[@]}" --jq "[.[] | select(.databaseId > $before and .displayTitle == \"$title\") | .databaseId] | min // empty" || true)
  [[ -z $run ]] || break
  sleep 2
done
if [[ -z $run ]]; then
  failed "$tap started no update-formula run within a minute of the cask $version being sent"
fi
url="https://github.com/$tap/actions/runs/$run"
echo "Sent $tap the cask $version: sha256 $sha; its update is $url"
if ! gh run watch "$run" -R "$tap" --exit-status --interval 5 > /dev/null; then
  failed "$tap's update of the cask $version failed, at $url"
fi
echo "The cask is on $version: $url"
