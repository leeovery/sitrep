#!/bin/bash
# Builds SitRep.app into the folder given, signed with Lee's Developer ID,
# carrying the plugin and the notices helper: app/build runs it, then installs
# what it made, and app/release-build, with --release, notarizes it. The
# folder must be outside the repository, and the bundle gone once installed: a
# second signed copy left about could be the one macOS launches by its bundle
# id.
set -euo pipefail

release=false
if [[ ${1-} == --release ]]; then
  release=true
  shift
fi
if [[ $# -ne 1 ]]; then
  echo "Usage: app/bundle [--release] <folder>" >&2
  exit 1
fi

# macOS ties the leave to control Ghostty, notifications and the login item to
# the bundle id and the Developer ID's team, not to a build or a certificate,
# so a build from here and a release share them.
identity="Developer ID Application: PointsBox Limited (CQKZZ4FN6V)"
app=$(cd "$(dirname "$0")" && pwd)
repo=$(dirname "$app")
work=$1
bundle="$work/SitRep.app"

if [[ -e "$bundle" ]]; then
  echo "$bundle is there already: app/bundle makes one into a folder without one." >&2
  exit 1
fi

# Signed by the identity's hash: after a renewal the keychain holds two of the
# name, and codesign refuses a name that is ambiguous.
signer=$(security find-identity -v -p codesigning | grep -F "\"$identity\"" | awk '{ print $2 }' || true)
if [[ -z $signer ]]; then
  echo "No \"$identity\" signing identity in the keychain: SitRep is signed with it." >&2
  exit 1
fi
if [[ $(wc -l <<< "$signer") -gt 1 ]]; then
  echo "The keychain holds more than one \"$identity\" signing identity:" >&2
  echo "$signer" >&2
  echo "Remove the old one from the keychain, and keep the one to sign with." >&2
  exit 1
fi

# Under the hardened runtime. A release's signatures carry a secure timestamp,
# which notarizing needs: codesign fails without one, as when Apple's server
# can't be reached. Any other build's carry none, so it builds offline.
if $release; then
  timestamp=--timestamp
else
  timestamp=--timestamp=none
fi
sign() {
  codesign --force --options runtime "$timestamp" -s "$signer" "$@"
}

# One version covers the plugin and the app: plugin.json's, or, as mint's
# pre_tag runs before mint writes it there, the version mint is releasing.
version=${MINT_NEW_VERSION:-$(plutil -extract version raw -o - "$repo/.claude-plugin/plugin.json")}

# The link is given the SDK as -isysroot. SwiftPM hands it to clang's link
# only as --sysroot and with no SDKROOT, so clang records the deployment
# target as the SDK the app was built with, and macOS draws an app in the
# design of the SDK it records: linked without it, SitRep was drawn as on
# macOS 14, with none of the system's Liquid Glass.
build=(-c release --package-path "$app" -Xswiftc -Xclang-linker -Xswiftc -isysroot -Xswiftc -Xclang-linker -Xswiftc "$(xcrun --show-sdk-path)")
swift build "${build[@]}"
binaries=$(swift build "${build[@]}" --show-bin-path)

mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"
cp "$binaries/SitRep" "$bundle/Contents/MacOS/SitRep"
info="$bundle/Contents/Info.plist"
cp "$app/Info.plist" "$info"
plutil -insert CFBundleShortVersionString -string "$version" "$info"
plutil -insert CFBundleVersion -string "$version" "$info"

# The notices helper, which posts SitRep's banners: a click on one activates
# the app that posted it, and the helper has no window, so macOS has no Space
# to take Lee to, where SitRep's window would take him to its own ahead of the
# jump. Its bundle id is SitRep's and .notices, as SitRep's NoticeHelper has
# it, and its name SitRep, so a banner's header says SitRep. It takes SitRep's
# version and the macOS it needs.
helper="$bundle/Contents/Helpers/SitRepNotices.app"
mkdir -p "$helper/Contents/MacOS" "$helper/Contents/Resources"
cp "$binaries/SitRepNotices" "$helper/Contents/MacOS/SitRepNotices"
helper_info="$helper/Contents/Info.plist"
cp "$app/Notices/Info.plist" "$helper_info"
plutil -insert CFBundleIdentifier -string "$(plutil -extract CFBundleIdentifier raw -o - "$info").notices" "$helper_info"
plutil -insert CFBundleShortVersionString -string "$version" "$helper_info"
plutil -insert CFBundleVersion -string "$version" "$helper_info"
plutil -insert LSMinimumSystemVersion -string "$(plutil -extract LSMinimumSystemVersion raw -o - "$info")" "$helper_info"

# The plugin the app installs, as Claude Code runs it from this checkout:
# what the plugin loads (its manifests, the mod, the core, their types and its
# sound), as the checkout stands, edits and files not yet committed among
# them but not what git ignores, and its CLI compiled by Bun, so a Mac with
# the app needs no Bun. The app's source, the tests and the CLI's own source
# stay behind.
plugin="$bundle/Contents/Resources/Plugin"
mkdir "$plugin"
git -C "$repo" ls-files -z --cached --others --exclude-standard -- .claude-plugin hooks core types |
  while IFS= read -r -d '' file; do
    if [[ -e "$repo/$file" ]]; then
      mkdir -p "$plugin/$(dirname "$file")"
      cp -p "$repo/$file" "$plugin/$file"
    fi
  done
# Its version is the app's, which plugin.json doesn't hold yet under mint's
# pre_tag, written as mint's version_pattern writes it.
manifest="$plugin/.claude-plugin/plugin.json"
sed -E -i '' "s/\"version\": \"[^\"]*\"/\"version\": \"$version\"/" "$manifest"
if [[ $(plutil -extract version raw -o - "$manifest") != "$version" ]]; then
  echo "$manifest names no version $version once written." >&2
  exit 1
fi
# Bun makes the binary in the folder it runs in, then moves it; one it cannot
# move, to another volume, it copies and leaves behind.
cli="$plugin/bin/sitrep"
(cd "$work" && bun build --compile "$repo/cli/shell/run.ts" --outfile "$cli" > /dev/null)
sign --identifier "$(plutil -extract CFBundleIdentifier raw -o - "$info").cli" --entitlements "$app/CLI.entitlements" "$cli"
# Its build, a digest of its files, which the app compares with its own
# copy's, so a build at the same version from other edits still replaces it.
# The CLI is among them as signed, and a signature records its time, a
# release's as Apple's timestamp and any other's as the Mac's clock, so every
# build's digest is new and replaces the copy.
(cd "$plugin" && find . -type f -print0 | sort -z | xargs -0 shasum -a 256 | shasum -a 256 | cut -c1-16) > "$plugin/.sitrep-build"

# The icon, compiled from its Icon Composer layers: Assets.car, from which
# macOS makes the dark, clear and tinted looks, and an .icns for older
# lookups, every size to 1024 (by default actool stops at 256). actool names
# them, and its keys go into the Info.plist. The helper carries the same, so
# its banners and its row in System Settings show SitRep's icon.
icon="$work/icon"
mkdir "$icon"
xcrun actool "$app/Icon/SitRep.icon" --compile "$icon" --platform macosx \
  --minimum-deployment-target "$(plutil -extract LSMinimumSystemVersion raw -o - "$info")" \
  --app-icon SitRep --standalone-icon-behavior all --output-partial-info-plist "$work/icon.plist" \
  > "$work/actool.plist"
# actool exits 0 having compiled nothing, as for an icon it cannot find, its
# errors only in what it prints.
if [[ ! -f "$icon/Assets.car" ]]; then
  echo "actool compiled no icon from $app/Icon/SitRep.icon:" >&2
  cat "$work/actool.plist" >&2
  exit 1
fi
for each in "$bundle" "$helper"; do
  cp "$icon"/* "$each/Contents/Resources"
  /usr/libexec/PlistBuddy -c "Merge $work/icon.plist" "$each/Contents/Info.plist" > /dev/null
done
rm -r "$icon" "$work/icon.plist" "$work/actool.plist"

# Inside out, never with --deep: the CLI as it was made, then the helper, as
# SitRep's signature seals the helper's as it stands. The helper sends no
# Apple Events, so it takes no entitlements.
sign "$helper"
sign --entitlements "$app/SitRep.entitlements" "$bundle"

# Each part as macOS will judge it: by the Developer ID, under the hardened
# runtime, a release's with a secure timestamp, and with the entitlements it
# was given and no others. The app's --deep checks the CLI only as a file it
# seals, so the CLI's own signature is verified too.
codesign --verify --deep --strict "$bundle"
codesign --verify --strict "$cli"
check() {
  local part=$1 given=$2 details signed expected=""
  details=$(codesign -dvv "$part" 2>&1 || true)
  # In one form, keys sorted as plutil writes them.
  signed=$(codesign -d --entitlements - --xml "$part" 2> /dev/null | plutil -convert xml1 -o - - 2> /dev/null || true)
  [[ -z $given ]] || expected=$(plutil -convert xml1 -o - "$given")
  if ! grep -qF "Authority=$identity" <<< "$details" || ! grep -q "(runtime)" <<< "$details" ||
    { $release && ! grep -q "^Timestamp=" <<< "$details"; } || [[ $signed != "$expected" ]]; then
    echo "$part is not signed as app/bundle signs it:" >&2
    echo "$details" >&2
    codesign -d --entitlements - "$part" >&2
    exit 1
  fi
}
check "$cli" "$app/CLI.entitlements"
check "$helper" ""
check "$bundle" "$app/SitRep.entitlements"
