# shellcheck shell=bash
#
# What app/bundle and app/notarize, which source it, agree on: the signing
# keychain they sign and notarize from, and how they open it.

# The signing keychain, which kit's developer-id step makes, holds the
# Developer ID identity and notarytool's profile. It opens with the .p12's
# password, DEVELOPER_ID_P12_PASSWORD, which kit writes to ~/.secrets.zsh, so
# app/bundle and app/notarize unlock it themselves and ask nothing, at the Mac
# or over SSH. Every codesign and notarytool call names it, and kit's step
# puts it first on the keychain search list, where codesign finds the key
# whatever --keychain names.
keychain=$HOME/Library/Keychains/signing.keychain-db
# notarytool's login is the Mac's, whatever it notarizes, so its profile is
# named for notarytool, not for SitRep.
profile=notarytool
# How every notarytool call signs in: the profile, in the signing keychain.
# shellcheck disable=SC2034 # read by app/notarize
notary=(--keychain "$keychain" --keychain-profile "$profile")
# What a command handed to a person runs first, so it opens the signing
# keychain however the shell came: the variable's name, never its value.
# shellcheck disable=SC2034 # read by app/notarize
unlock_command="security unlock-keychain -p \"\$DEVELOPER_ID_P12_PASSWORD\" $keychain"

# signing_fail says why the run stops, and stops it.
signing_fail() {
  echo "$1" >&2
  exit 1
}

# unlock_keychain unlocks the signing keychain with its password, so nothing
# that signs or notarizes asks for it.
unlock_keychain() {
  [[ -f $keychain ]] || signing_fail "There's no signing keychain at $keychain: kit apply makes it, its developer-id step."
  # A shell that hasn't read ~/.secrets.zsh, as a plain ssh command's, an
  # agent's or one started before kit wrote it, finds the password there.
  if [[ -z ${DEVELOPER_ID_P12_PASSWORD:-} && -f $HOME/.secrets.zsh ]]; then
    DEVELOPER_ID_P12_PASSWORD=$(zsh -fc 'source ~/.secrets.zsh && print -rn -- "${DEVELOPER_ID_P12_PASSWORD-}"') ||
      DEVELOPER_ID_P12_PASSWORD=
  fi
  [[ -n ${DEVELOPER_ID_P12_PASSWORD:-} ]] || signing_fail "DEVELOPER_ID_P12_PASSWORD isn't set, nor in ~/.secrets.zsh, so the signing keychain can't be unlocked: kit secret sync writes it to ~/.secrets.zsh."
  security unlock-keychain -p "$DEVELOPER_ID_P12_PASSWORD" "$keychain" ||
    signing_fail "The signing keychain doesn't open with DEVELOPER_ID_P12_PASSWORD, as security says above: security delete-keychain $keychain, then kit apply, which makes it again with notarytool's profile."
  # Behind a keychain holding the same identity, as the login keychain may,
  # codesign takes that one's key, locked over SSH.
  [[ $(security list-keychains -d user | head -n 1 | tr -d ' "') == "$keychain" ]] ||
    signing_fail "The signing keychain isn't first on the keychain search list, where codesign finds its key whatever --keychain names: kit apply puts it there, its developer-id step."
}
